# Copy to .env.local; never commit real secrets.
# Set your custom domain here. Leave unset on Vercel to use its system URL.
# Development: http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Turso Cloud remote database (server-only).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# OpenAI-compatible AI provider; required only to send chat messages.
ROUTER_APIKEY=
ROUTER_BASE_URL=
ROUTER_MODEL=

# Retention: 1..365 days. Expired messages are excluded from reads immediately.
# Daily Vercel cron physically deletes them.
CHAT_RETENTION_DAYS=30

# Vercel IP headers are trusted automatically when VERCEL=1.
# Else only enable behind a proxy that overwrites x-real-ip.
CHAT_TRUST_PROXY=false

# At least 32 random characters, required for the production cleanup cron.
CRON_SECRET=

